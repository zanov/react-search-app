{
  "name": "react-search-app",
  "version": "1.0.0",
  "description": "SPA search app",
  "main": "index.tsx",
  "scripts": {
    "start": "concurrently \"npm run start-react\" \"npm run start-express\"",
    "start-react": "webpack serve --mode development",
    "start-express": "node server/express.js",
    "build": "webpack --mode production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "moduleNameMapper": {
      "^Components/(.*)$": "<rootDir>/src/components/$1",
      "^Redux/(.*)$": "<rootDir>/src/redux/$1",
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.(ts|tsx)$": "babel-jest"
    },
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.(ts|tsx|js)",
      "<rootDir>/src/**/?(*.)(test|spec).(ts|tsx|js)"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zanov/react-search-app.git"
  },
  "author": "Ivo Tsanov",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zanov/react-search-app/issues"
  },
  "homepage": "https://github.com/zanov/react-search-app#readme",
  "dependencies": {
    "@babel/core": "^7.23.2",
    "@babel/preset-typescript": "^7.23.2",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "babel-loader": "^9.1.3",
    "bootstrap": "^5.3.2",
    "css-loader": "^6.8.1",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "express": "^4.18.2",
    "moment": "^2.29.4",
    "prettier": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.16.0",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
    "reselect": "^5.1.1",
    "style-loader": "^3.3.3",
    "typescript": "^5.2.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-react": "^7.22.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react-dom": "^18.2.13",
    "concurrently": "^8.2.1",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "redux-mock-store": "^1.5.5",
    "tsconfig-paths-webpack-plugin": "^4.1.0"
  }
}
